{
  "name": "@axiomchess/web",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing site, analyzer UI, and report pages for AxiomChess",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && tsc --noEmit --pretty false",
    "test": "vitest run",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
