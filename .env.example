# Browser API base. Leave empty to call same-origin /v1/* via Next.js rewrite.
# Set only when the API is on another public origin.
NEXT_PUBLIC_API_BASE_URL=

# Server-side rewrite target for /v1/* (build-time in next.config.ts)
# Local: http://127.0.0.1:3000
# Production (Vercel project axiomchess): https://axiomchess-api.vercel.app
API_PROXY_TARGET=http://127.0.0.1:3000
